{
	"name": "@theedoran/gc",
	"version": "0.5.2",
	"description": "Generate and create focused Git commits with AI",
	"keywords": [
		"ai",
		"cli",
		"commit",
		"git"
	],
	"homepage": "https://github.com/TheEdoRan/gc#readme",
	"bugs": {
		"url": "https://github.com/TheEdoRan/gc/issues"
	},
	"license": "MIT",
	"author": "Edoardo Ranghieri",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/TheEdoRan/gc.git"
	},
	"bin": {
		"gc": "./dist/index.mjs"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"build": "tsdown",
		"check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
		"demo": "node scripts/demo.ts",
		"format": "oxfmt . --write",
		"format:check": "oxfmt . --check",
		"lint": "oxlint . --type-aware --report-unused-disable-directives",
		"prepublishOnly": "pnpm build",
		"release": "changeset publish",
		"test": "node --test",
		"typecheck": "tsc --noEmit",
		"version-packages": "changeset version"
	},
	"dependencies": {
		"@ai-sdk/anthropic": "3.0.23",
		"@ai-sdk/openai": "4.0.30",
		"@ai-sdk/openai-compatible": "3.0.23",
		"@inquirer/core": "11.2.1",
		"@inquirer/external-editor": "3.0.3",
		"@inquirer/prompts": "8.5.2",
		"ai": "7.0.52",
		"env-paths": "4.0.0",
		"yaml": "2.9.0"
	},
	"devDependencies": {
		"@changesets/cli": "2.31.1",
		"@types/node": "26.1.2",
		"oxfmt": "0.62.0",
		"oxlint": "1.77.0",
		"oxlint-tsgolint": "7.0.2001",
		"tsdown": "0.22.14",
		"typescript": "7.0.2"
	},
	"engines": {
		"node": ">=22.13.0"
	},
	"packageManager": "pnpm@11.20.0"
}
